---
import Base from "../../layouts/Base.astro";
import Gauge from "../../components/Gauge.astro";
import Sparkline from "../../components/Sparkline.astro";
import AdSlot from "../../components/AdSlot.astro";
import WikiNotice from "../../components/WikiNotice.astro";
import MemberStar from "../../components/MemberStar.astro";
import Saying from "../../components/Saying.astro";
import { aggregates, sparklines, items } from "../../lib/data";
import { GAUGE, SITE } from "@geoffery/content";
import { marketCharacter } from "@geoffery/core";
import { gp, itemTitle, metaDescription } from "../../lib/format";

export function getStaticPaths() {
  const aggs = aggregates();
  return Object.values(aggs).map((a) => ({ params: { slug: a.slug }, props: { agg: a } }));
}

const { agg } = Astro.props;
const slug = agg.slug;
const spark = sparklines()[slug];

// AggregateView carries no members flag — join from the search index by slug.
const memberMap = new Map(items().map((i) => [i.slug, i.members]));
const isMember = memberMap.get(slug) ?? false;

// Market character: a clearly-trending item reads as Falling/Rising with its 30-day move;
// otherwise the 3-level IQR-spread volatility badge (owner directive 2026-06-18 — the
// volatility level alone called a smoothly-falling item "Steady").
const market = marketCharacter(agg.change30d, agg.p25, agg.p50, agg.p75);
const marketLabel =
  market.kind === "trend"
    ? `${market.direction === "down" ? GAUGE.trend.falling : GAUGE.trend.rising} ${Math.round(Math.abs(market.changePct))}%`
    : GAUGE.volatility[market.level];
const marketClass = market.kind === "trend" ? `trend-${market.direction}` : `vol-${market.level}`;

const desc = metaDescription(agg.name, agg.verdictText);

// Breadcrumb + FAQ-less structured data for the item.
const ld = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: agg.name,
  offers: agg.currentPrice
    ? { "@type": "Offer", priceCurrency: "GP", price: Math.round(agg.currentPrice), availability: "https://schema.org/InStock" }
    : undefined,
};
---

<Base title={itemTitle(agg.name)} description={desc} canonicalPath={`/item/${slug}/`} itemSlug={slug} itemName={agg.name}>
  <div class="wrap">
    <article class="panel item-top">
      <h1>{agg.name}<MemberStar members={isMember} /></h1>
      <Saying page="item" tone="dark" />

      <div class="prices">
        <div class="price">
          <span class="small muted">Market price</span>
          <span class="price-big">{gp(agg.currentPrice)}</span>
        </div>
        <div class="price">
          <span class="small muted">Hourly volume</span>
          <span class="price-big">{gp(agg.volume24h ? Math.round(agg.volume24h / 24) : null)}</span>
        </div>
        {agg.p50 != null && (
          <div class="price">
            <span class="small muted">Market</span>
            <span class={`vol-badge ${marketClass}`}>{marketLabel}</span>
          </div>
        )}
      </div>

      <!-- consultation recommendation lands here, above the gauge -->
      <div id="consulted-panel" class="consulted" hidden></div>

      <Gauge agg={agg} />

      <p class="advice-note small muted">{SITE.adviceDisclaimer}</p>
    </article>

    <AdSlot kind="item-mid" />
    <AdSlot kind="mobile" />

    {agg.wikiNotices.length > 0 && <WikiNotice notices={agg.wikiNotices} />}

    {spark && (
      <section class="panel charts">
        <h2>Recent trend</h2>
        <div class="spark-grid">
          <div><span class="small muted">Last 24 hours</span><Sparkline points={spark.d1} label={`${agg.name} 24h`} /></div>
          <div><span class="small muted">Last week</span><Sparkline points={spark.w1} label={`${agg.name} 1w`} /></div>
          <div><span class="small muted">Last month</span><Sparkline points={spark.m1} label={`${agg.name} 1m`} /></div>
        </div>
      </section>
    )}

    <AdSlot kind="item-bottom" />
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(ld)} />

  <script>
    import { renderConsulted } from "../../scripts/consulted.ts";
    renderConsulted();
  </script>
</Base>

<style>
  .item-top { margin-top: var(--s-4); }
  .item-top h1 { margin: 0 0 4px; }
  /* Space the three stats across the full panel width (owner feedback 2026-06-14). */
  .prices { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-5); margin: var(--s-4) 0; }
  .prices .price { flex: 0 1 auto; }
  .price { display: flex; flex-direction: column; }
  /* Color-graded volatility badge (owner directive 2026-06-13): calm → warm → red. */
  .vol-badge {
    align-self: flex-start; margin-top: 4px;
    display: inline-block; padding: 3px 12px; border-radius: 999px;
    font-family: var(--sans); font-size: 0.95rem; font-weight: 600; border: 1px solid;
  }
  .vol-steady { background: #d4e6c8; color: #2e6b2a; border-color: #a9cf98; }
  .vol-some { background: #f0e0b0; color: #855410; border-color: #d9c184; }
  .vol-high { background: #f1cdc7; color: #a3271b; border-color: #dca79f; }
  /* Directional 30-day trend — informational (not a green/red value signal); design may refine. */
  .trend-down { background: #dce6ef; color: #2f4d6e; border-color: #b6c8dc; }
  .trend-up { background: #efe4d2; color: #6e4d2f; border-color: #dac7ad; }
  .charts { margin-top: var(--s-4); }
  .spark-grid { display: grid; gap: var(--s-4); grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  .consulted { margin: var(--s-4) 0; padding: var(--s-4); border-radius: var(--radius); background: var(--bg-raised); color: var(--paper-text); border: 1px solid var(--brass); }
  .consulted .rec-line { font-family: var(--serif); font-size: 1.15rem; }
  .advice-note { display: block; margin-top: var(--s-4); line-height: 1.5; }
</style>
