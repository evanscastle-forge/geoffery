---
import Base from '../layouts/Base.astro';
import Dialogue from '../components/Dialogue.astro';
import lines from '../content/geoffery-lines.json';
---

<Base title="About Geoffery" description="Who Geoffery is, and why he keeps the ledger.">
  <h1>About</h1>
  <Dialogue text={lines.tagline_long} />

  <p>
    Geoffery is a small, independent project: a place to check what an item is currently
    worth on the Grand Exchange, rated against its own thirty-day history, before you
    place an offer. He is run by one person, kept honest by a single rule —
    <em>everything about the market is free, and stays free</em> — and is not affiliated
    with Jagex Ltd. in any way.
  </p>
  <p>
    Prices are sourced from the <a href="https://oldschool.runescape.wiki/w/RuneScape:Real-time_Prices" target="_blank" rel="noopener">OSRS Wiki real-time prices API</a>.
    Geoffery would not exist without it.
  </p>
  <p class="ui muted">Questions or complaints: <a href="mailto:evanscastle.forge@gmail.com">evanscastle.forge@gmail.com</a>.</p>
</Base>

<style>
  .muted { color: var(--c-ink-faint); }
</style>
