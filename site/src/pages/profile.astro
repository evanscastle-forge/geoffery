---
import Base from "../layouts/Base.astro";
import Dialogue from "../components/Dialogue.astro";
import { PAGES } from "@geoffery/content";

// Stubbed Login/Profile (owner feedback 2026-06-12). No real auth or charging —
// accounts are deferred (D-MONEY-001). The tip-jar fullness is a local demo; a
// state switcher previews the four house-drawn jar states. noindex.
const P = PAGES.profile;
const jarSrc = ["/tipjar-0-empty.svg", "/tipjar-1-low.svg", "/tipjar-2-full.svg", "/tipjar-3-overflowing.svg"];
---

<Base title="Your profile — Geoffery" noindex={true}>
  <div class="wrap measure">
    <h1>{P.title}</h1>
    <Dialogue><p>{P.intro}</p></Dialogue>

    <p class="proto small muted">{P.prototypeNote}</p>

    <section class="panel jar-card">
      <h2>{P.jarHeading}</h2>
      <p class="small muted">{P.jarNote}</p>
      <div class="jar-display">
        <img id="jar-img" src={jarSrc[1]} alt={`Tip jar — ${P.jarStates[1]}`} width="120" height="140" />
        <span id="jar-label" class="jar-label">{P.jarStates[1]}</span>
      </div>
      <label class="jar-control">
        <span class="small muted">Demo fill level</span>
        <input id="jar-range" type="range" min="0" max="3" step="1" value="1" aria-label="Demo tip-jar fill level" />
      </label>
    </section>

    <section class="panel settings-card">
      <h2>{P.settingsHeading}</h2>
      <label class="field">
        <span>Display name</span>
        <input id="pref-name" type="text" autocomplete="off" placeholder="Anonymous patron" />
      </label>
      <label class="field check">
        <input id="pref-reduce-motion" type="checkbox" />
        <span>Reduce the bell's animation</span>
      </label>
      <p class="small muted">Preferences are stored on this device only — part of the prototype.</p>
    </section>
  </div>
</Base>

<script define:vars={{ jarSrc, jarStates: PAGES.profile.jarStates }}>
  const $ = (id) => document.getElementById(id);
  const range = $("jar-range"), img = $("jar-img"), label = $("jar-label");
  function paintJar(n) {
    const i = Math.max(0, Math.min(3, Number(n)));
    img.src = jarSrc[i];
    img.alt = `Tip jar — ${jarStates[i]}`;
    label.textContent = jarStates[i];
    localStorage.setItem("geoffery_jar_demo", String(i));
  }
  const savedJar = localStorage.getItem("geoffery_jar_demo");
  if (savedJar !== null) { range.value = savedJar; paintJar(savedJar); }
  range.addEventListener("input", () => paintJar(range.value));

  const name = $("pref-name"), reduce = $("pref-reduce-motion");
  name.value = localStorage.getItem("geoffery_pref_name") || "";
  reduce.checked = localStorage.getItem("geoffery_pref_reduce_motion") === "1";
  name.addEventListener("input", () => localStorage.setItem("geoffery_pref_name", name.value));
  reduce.addEventListener("change", () => localStorage.setItem("geoffery_pref_reduce_motion", reduce.checked ? "1" : "0"));
</script>

<style>
  .proto { margin: var(--s-4) 0 0; }
  .jar-card, .settings-card { margin-top: var(--s-5); }
  .jar-display { display: grid; justify-items: center; gap: 6px; margin: var(--s-4) 0; }
  .jar-display img { width: 120px; height: auto; }
  .jar-label { font-family: var(--serif); font-size: 1.1rem; color: var(--ink); }
  .jar-control { display: grid; gap: 6px; max-width: 320px; margin: 0 auto; text-align: center; }
  .jar-control input { width: 100%; accent-color: var(--brass-deep); }
  .field { display: grid; gap: 6px; margin: var(--s-4) 0; }
  .field.check { grid-auto-flow: column; justify-content: start; align-items: center; gap: 10px; }
  .field input[type="text"] { padding: 8px 12px; border-radius: var(--radius); border: 1px solid var(--panel-edge); background: var(--panel); color: var(--ink); }
</style>
