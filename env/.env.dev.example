# env/.env.dev — deploy config for `ops/run.sh dev` (dev.geoffery.gg).
# Copy to env/.env.dev and fill in. This file is sourced by run.sh and feeds
# wrangler; it is NOT loaded by the localhost stack (that uses root .env).
#
# Secrets rule: never paste a secret into chat. Fill values here directly, or
# (preferred for the API token) run `wrangler login` once instead. Worker
# secrets like ANTHROPIC_API_KEY are set with `ops/run.sh dev secret <NAME> <worker>`,
# never stored here.

# Pinned by run.sh's preflight — must equal the target ("dev").
GEOFFERY_DEPLOYMENT_NAME=dev
GEOFFERY_SITE_URL=https://dev.geoffery.gg
GEOFFERY_USER_AGENT="Geoffery dev (contact@evancastle.com)"

# Cloudflare account + zone (required by the deploy preflight). The account id is
# on the Cloudflare dashboard home; the zone is the registrable apex.
CLOUDFLARE_ACCOUNT_ID=
GEOFFERY_ZONE=geoffery.gg

# API token (OPTIONAL — prefer `wrangler login`). If you set it, it is a secret:
# fill it here in your editor, never in chat. Scope: Workers Scripts + Pages +
# D1 + R2 edit on this account only.
CLOUDFLARE_API_TOKEN=

# News classifier model (the ANTHROPIC_API_KEY itself is a wrangler secret).
GEOFFERY_NEWS_CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# NB: D1 database_id, R2 bucket names, and KV ids are NOT here — they live in
# ops/wrangler/*.toml under [env.dev] (search REPLACE_WITH_DEV_). Create them with
# `wrangler d1 create geoffery-dev` / `wrangler r2 bucket create geoffery-archive-dev`.
