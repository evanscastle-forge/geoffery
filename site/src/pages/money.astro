---
import Base from "../layouts/Base.astro";
import Dialogue from "../components/Dialogue.astro";
import Saying from "../components/Saying.astro";
import { PAGES, DONATIONS, jarLevel, easterEggPatrons } from "@geoffery/content";
import { cleanName } from "@geoffery/core";

// Tips are real now (Stripe Checkout, spec §7/§8): the buttons POST /api/tip and hand the
// patron to Stripe; the thank-you/cookie/jar fire only on the success return. The jar
// level + patrons wall read live per-month totals from the export (donations.json), merged
// with the curated seed (@geoffery/content) and the easter-egg patrons. Amounts are never
// shown — only the fill level (spec §8).
const M = PAGES.money;
const jarSrc = ["/tipjar-1.png", "/tipjar-2.png", "/tipjar-3.png", "/tipjar-4.png", "/tipjar-5.png"];
const jarAlt = ["nearly empty", "filling", "half full", "nearly full", "full"];
const DEFAULT_GOAL = 50;

const nowKey = new Date().toISOString().slice(0, 7);

// Live per-month tips from the build-time export (absent on a fresh checkout → {} ).
const liveFiles = import.meta.glob<{ months?: Record<string, { totalCents: number; donors: string[] }> }>(
  "../generated/donations.json",
  { eager: true, import: "default" },
);
const live = Object.values(liveFiles)[0]?.months ?? {};

const curatedByMonth = new Map(DONATIONS.map((m) => [m.month, m]));
const totalUsdFor = (key: string): number => {
  const l = live[key];
  return l ? Math.round(l.totalCents / 100) : (curatedByMonth.get(key)?.total ?? 0);
};
const goalFor = (key: string): number => curatedByMonth.get(key)?.goal ?? DEFAULT_GOAL;
// Curated seed names + live (opt-in) donor names + the month's easter-egg patrons, deduped.
const donorsFor = (key: string): string[] =>
  [...new Set([...(curatedByMonth.get(key)?.donors ?? []), ...(live[key]?.donors ?? []), ...easterEggPatrons(key)])].map(
    cleanName,
  );

const pretty = (key: string) =>
  new Date(`${key}-01T00:00:00Z`).toLocaleString("en-US", { month: "long", year: "numeric", timeZone: "UTC" });

const allMonthKeys = [...new Set([nowKey, ...DONATIONS.map((m) => m.month), ...Object.keys(live)])].sort().reverse();
const monthsData = allMonthKeys.map((key) => ({ key, label: pretty(key), donors: donorsFor(key) }));

const curLevel = jarLevel(totalUsdFor(nowKey), goalFor(nowKey));
const currentDonors = donorsFor(nowKey);
const tipCopy = { cancelled: M.tipCancelled, error: M.tipError };
---

<Base title="How this is paid for — Geoffery" description="Geoffery's wage is one gold a month. Tips fill a monthly jar that unlocks bonus consultations for everyone." canonicalPath="/money/" adFree>
  <div class="wrap measure">
    <h1>{M.title}</h1>
    <Saying page="money" />
    <Dialogue><p>{M.wage}</p></Dialogue>

    <section class="panel doc">
      <h2>{M.tipsHeading}</h2>
      <p>{M.tipsDisclosure}</p>

      <div class="jar">
        <img id="tip-jar" src={jarSrc[curLevel]} alt={`The month's tip jar — ${jarAlt[curLevel]}`} width="600" height="436" />
        <p class="small muted">{M.goalNote}</p>
      </div>

      <!-- Ad-free zone: no ad slots on the payment surface (spec §7). A suggested $5
           or a custom amount → a real Stripe Checkout (owner directive 2026-06-14). -->
      <div class="tips">
        <button class="tip-btn tip-suggested" type="button">Tip $5</button>
        <form id="tip-custom" class="tip-custom">
          <label class="small muted" for="tip-amount">Or name your own</label>
          <div class="tip-custom-row">
            <span class="tip-prefix" aria-hidden="true">$</span>
            <input id="tip-amount" name="amount" type="number" min="1" max="1000" step="1" inputmode="numeric" placeholder="10" aria-label="Custom tip amount in US dollars" />
            <button class="tip-btn" type="submit">Drop it in the jar</button>
          </div>
        </form>
      </div>

      <p id="tip-msg" class="tip-msg small muted" role="status" hidden></p>
      <div id="tip-note" class="chatbox tip-note" hidden><p>{M.tippedNote}</p></div>
    </section>

    <section class="panel donors">
      <div class="donors-head">
        <h2>{M.donorsHeading}</h2>
        <label class="month-pick">
          <span class="small muted">{M.monthLabel}</span>
          <select id="month-select">
            {monthsData.map((m) => <option value={m.key} selected={m.key === nowKey}>{m.label}</option>)}
          </select>
        </label>
      </div>
      <ul id="donor-list" class="names">
        {currentDonors.map((n) => <li>{n}</li>)}
      </ul>
      <p id="no-donors" class="muted" hidden={currentDonors.length > 0}>{M.noDonors}</p>
    </section>
  </div>
</Base>

<script define:vars={{ monthsData, nowKey, tipCopy }}>
  // Month picker — switch the rendered donor list (all months embedded above).
  const select = document.getElementById("month-select");
  const list = document.getElementById("donor-list");
  const empty = document.getElementById("no-donors");
  function render(key) {
    const m = monthsData.find((x) => x.key === key);
    const donors = m ? m.donors : [];
    list.innerHTML = "";
    for (const n of donors) {
      const li = document.createElement("li");
      li.textContent = n;
      list.appendChild(li);
    }
    empty.hidden = donors.length > 0;
  }
  select?.addEventListener("change", () => render(select.value));

  const msg = document.getElementById("tip-msg");
  function showMsg(text) {
    if (!msg) return;
    msg.textContent = text;
    msg.hidden = false;
    msg.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  // A tip → a real Stripe Checkout Session. POST the amount; the worker returns a hosted
  // checkout url and we hand the patron to Stripe. The thank-you/cookie/jar happen only on
  // the success return (below), never on click.
  async function startTip(amountUsd) {
    const cents = Math.round(Number(amountUsd) * 100);
    if (!Number.isFinite(cents) || cents < 100) {
      showMsg("A coin is a whole dollar at least.");
      return;
    }
    try {
      const res = await fetch("/api/tip", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ amountCents: cents }),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.url) {
        window.location.href = data.url;
        return;
      }
      showMsg(data.error || tipCopy.error);
    } catch {
      showMsg(tipCopy.error);
    }
  }
  document.querySelector(".tip-suggested")?.addEventListener("click", () => startTip(5));
  document.getElementById("tip-custom")?.addEventListener("submit", (e) => {
    e.preventDefault();
    startTip(document.getElementById("tip-amount")?.value || 0);
  });

  // Return from Stripe. ?tip=thanks → set the per-month tipper cookie (Bell-unlimited this
  // month, read by the Bell), show the thank-you, fill the jar. Soft-trust: the cookie only
  // grants extra consultations, never market data. ?tip=cancelled → a gentle note.
  const tipState = new URLSearchParams(location.search).get("tip");
  if (tipState === "thanks") {
    const end = new Date();
    end.setUTCMonth(end.getUTCMonth() + 1, 1);
    end.setUTCHours(0, 0, 0, 0);
    const maxAge = Math.max(60, Math.floor((end.getTime() - Date.now()) / 1000));
    document.cookie = `geoffery_tip_${nowKey}=1; path=/; max-age=${maxAge}; samesite=lax`;
    const note = document.getElementById("tip-note");
    if (note) { note.hidden = false; note.scrollIntoView({ behavior: "smooth", block: "nearest" }); }
    const jar = document.getElementById("tip-jar");
    if (jar) jar.src = "/tipjar-5.png";
    history.replaceState(null, "", location.pathname);
  } else if (tipState === "cancelled") {
    showMsg(tipCopy.cancelled);
    history.replaceState(null, "", location.pathname);
  }
</script>

<style>
  .doc { margin-top: var(--s-5); }
  .jar { display: grid; justify-items: center; gap: 6px; margin: var(--s-5) 0; }
  .jar img { width: min(380px, 100%); height: auto; }
  .tips { display: flex; gap: var(--s-5); flex-wrap: wrap; align-items: flex-end; margin-top: var(--s-5); justify-content: center; }
  .tip-btn {
    padding: 10px 18px; border-radius: var(--radius);
    background: var(--brass); color: #1c1709; font-weight: 700; text-align:center;
    border: none; cursor: pointer; font-size: 1rem; font-family: var(--sans);
  }
  .tip-btn:hover { filter: brightness(1.05); }
  .tip-suggested { font-size: 1.15rem; padding: 12px 26px; }
  .tip-custom { display: grid; gap: 6px; }
  .tip-custom-row { display: flex; align-items: center; gap: 6px; }
  .tip-prefix { font-size: 1.2rem; color: var(--ink-soft); }
  .tip-custom input {
    width: 88px; padding: 9px 10px; border-radius: var(--radius);
    border: 1px solid var(--panel-edge); background: var(--panel); color: var(--ink);
    font-size: 1rem; font-family: var(--sans);
  }
  .tip-msg { margin-top: var(--s-4); text-align: center; }
  .tip-note { margin-top: var(--s-4); padding: var(--s-4); font-family: var(--chat-font); }
  .tip-note p { margin: 0; }

  .donors { margin-top: var(--s-5); }
  .donors-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-3); flex-wrap: wrap; }
  .donors-head h2 { margin: 0; border-bottom: none; }
  .month-pick { display: inline-flex; align-items: center; gap: 8px; }
  .month-pick select {
    padding: 6px 10px; border-radius: var(--radius); border: 1px solid var(--panel-edge);
    background: var(--panel); color: var(--ink); font-family: var(--sans); font-size: 0.95rem;
  }
  .names { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-3); margin: var(--s-4) 0 0; }
  .names li { background: var(--bg-raised); color: var(--paper-text); padding: 6px 12px; border-radius: 999px; }
</style>
