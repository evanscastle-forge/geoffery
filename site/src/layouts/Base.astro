---
import "../styles/global.css";
import { SITE, BELL } from "@geoffery/content";
import Bell from "../components/Bell.astro";
import Search from "../components/Search.astro";
import { meta } from "../lib/data";

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  itemSlug?: string;
  itemName?: string;
  /** Suppress the AdSense loader entirely (ad-free zones: the money/payment page, ledger). */
  adFree?: boolean;
}
const { title, description, canonicalPath, noindex, itemSlug, itemName, adFree } = Astro.props;
const site = Astro.site?.toString() || "http://127.0.0.1:4321";
const canonical = canonicalPath ? new URL(canonicalPath, site).toString() : undefined;
const m = meta();
const isLocal = (m.deployment ?? "local") === "local";
// AdSense (spec §7): manual units only, Auto Ads off (account setting). The loader is
// injected only when PUBLIC_ADSENSE_CLIENT is set (prod, post-approval) and the page is not
// an ad-free zone. Dev/localhost have no publisher id → dormant. Real fill is prod-only.
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const showAds = Boolean(adsenseClient) && !adFree;
const appVersion = import.meta.env.GEOFFERY_APP_VERSION;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {(noindex || isLocal) && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#17120c" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href="/fonts/pixel-operator-bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/pt-serif-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/geoffery.png" type="image/png" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <!-- Search Console verification is stubbed on localhost (DECISIONS D-LOCAL-004). -->
    <!-- AdSense site verification: present on every page (even ad-free ones) whenever a
         publisher id is set, so Google can verify ownership during review. -->
    {adsenseClient && <meta name="google-adsense-account" content={adsenseClient} />}
    {showAds && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`} crossorigin="anonymous"></script>
    )}
  </head>
  <body data-item-slug={itemSlug} data-item-name={itemName}>
    <header class="site-header">
      <div class="wrap header-inner">
        <div class="bar">
          <a class="brand" href="/" aria-label={SITE.name}>
            <!-- GE-OFFER-Y wordmark: the OFFER is the point (owner feedback 2026-06-12). -->
            <span class="wordmark" aria-hidden="true">GE<span class="offer">OFFER</span>Y</span>
          </a>
          <div class="header-actions">
            <!-- The bell sits centre-stage in the header (owner feedback 2026-06-14);
                 the panel + behaviour are in <Bell/> at the end of <body>. -->
            <button id="bell-ring" class="bell-ring" aria-haspopup="dialog" aria-controls="bell-panel" aria-label={BELL.ringAria}>
              <span class="bell-ico" aria-hidden="true">🔔</span>
              <span class="bell-ring-label">Ring the bell</span>
            </button>
          </div>
          <nav class="nav" aria-label="Primary">
            <a href="/">Home</a>
            <a class="nav-tip" href="/money/">Tip Geoffery</a>
            <a href="/about/">About</a>
          </nav>
        </div>
        <!-- Persistent site search on every page (owner feedback 2026-06-14). The
             homepage keeps its larger hero search instead, so skip it there to avoid
             a duplicate #site-search on one page. -->
        {canonicalPath !== "/" && <div class="header-search"><Search /></div>}
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <!-- Mirrors the header nav exactly (owner feedback 2026-06-12). -->
        <div class="links">
          <a href="/">Home</a>
          <a href="/money/">Tip Geoffery</a>
          <a href="/about/">About</a>
        </div>
        <p class="small">{SITE.footerDisclaimer}</p>
        <!-- Legal/compliance links — a separate row so the owner-locked Home·Tip·About
             mirror above stays untouched (footer mirrors header, feedback 2026-06-12). -->
        <div class="legal-links small">
          <a href="/methodology/">Methodology</a>
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
          <a href="/cookies/">Cookies</a>
        </div>
        <!-- Build/version tag → /version.json carries version + commit + builtAt. -->
        <p class="build-tag small"><a href="/version.json">v{appVersion}</a></p>
      </div>
    </footer>

    <Bell />
    <script is:inline>
      // Skip SW under automation (navigator.webdriver): a wedged SW instance hangs
      // every fetch in the CDP browser loop (observed 2026-06-12). Real users get the PWA.
      if ("serviceWorker" in navigator && !navigator.webdriver) {
        addEventListener("load", () => navigator.serviceWorker.register("/sw.js").catch(() => {}));
      } else if ("serviceWorker" in navigator) {
        navigator.serviceWorker.getRegistrations().then((rs) => rs.forEach((r) => r.unregister()));
      }
    </script>
  </body>
</html>
