{
  "extends": "./config/tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "workers/*/src/**/*.ts",
    "tools/*/src/**/*.ts",
    "ops/**/*.ts"
  ],
  // worker.ts entries + _shared use @cloudflare/workers-types (deploy-only,
  // bundled by wrangler) — out of the Node typecheck; main.node.ts stays checked.
  "exclude": [
    "node_modules",
    "**/dist",
    "site",
    "workers/*/src/worker.ts",
    "workers/_shared"
  ]
}
