---
/*
 * Tip jar — corner icon → small panel with Gold / Platinum / custom.
 * Payment links are static Stripe URLs; no backend at launch (charter
 * tie-breaker: less maintenance).
 *
 * Lockdown rule: live Stripe payment links render ONLY when
 * GEOFFERY_DEPLOYMENT_NAME=prod, regardless of what's in .env. qa and
 * local always show the "qa preview" notice — that way an accidental
 * Stripe URL pasted into the wrong env file can't take real money on a
 * non-production zone.
 */
import lines from '../content/geoffery-lines.json';
import { isProd, deployment } from '../lib/env';

const gold     = import.meta.env.PUBLIC_STRIPE_TIP_GOLD_URL     ?? '';
const platinum = import.meta.env.PUBLIC_STRIPE_TIP_PLATINUM_URL ?? '';
const custom   = import.meta.env.PUBLIC_STRIPE_TIP_CUSTOM_URL   ?? '';
const linksFilled = [gold, platinum, custom].every(
  (u) => u && !u.includes('REPLACE_ME')
);
const configured = isProd && linksFilled;
---

<button class="tip-jar" id="tip-jar-toggle" aria-haspopup="dialog" aria-expanded="false" aria-controls="tip-jar-panel" title="Tip jar">
  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
    <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.5" />
    <text x="12" y="16" font-family="ui-serif, Georgia, serif" font-size="11" fill="currentColor" text-anchor="middle" font-style="italic">G</text>
  </svg>
</button>

<dialog id="tip-jar-panel" class="tip-panel">
  <header>
    <h2 class="ui">A coin in the jar</h2>
    <button class="close" id="tip-close" aria-label="Close">✕</button>
  </header>
  <p class="ask">{lines.tip_ask_default}</p>
  {configured ? (
    <ul class="options">
      <li><a class="opt" href={gold} target="_blank" rel="noopener">
        <span class="coin coin-gold">G</span>
        <span><strong>Gold</strong><small class="ui">$1</small></span>
      </a></li>
      <li><a class="opt" href={platinum} target="_blank" rel="noopener">
        <span class="coin coin-plat">P</span>
        <span><strong>Platinum</strong><small class="ui">$10</small></span>
      </a></li>
      <li><a class="opt" href={custom} target="_blank" rel="noopener">
        <span class="coin coin-custom">⊛</span>
        <span><strong>Custom</strong><small class="ui">any amount</small></span>
      </a></li>
    </ul>
  ) : !isProd ? (
    <p class="not-configured ui">
      The jar is shut on the <strong>{deployment}</strong> deployment. Real
      coins are only accepted on the public site.
    </p>
  ) : (
    <p class="not-configured ui">
      The jar awaits its handles. Set the three
      <code>PUBLIC_STRIPE_TIP_*_URL</code> values in <code>.env.prod</code>.
    </p>
  )}
</dialog>

<style>
  .tip-jar {
    position: fixed; right: var(--s-4); bottom: var(--s-4);
    width: 44px; height: 44px;
    background: var(--c-bg-raised);
    color: var(--c-accent);
    border: 1px solid var(--c-rule);
    border-radius: 999px;
    display: grid; place-items: center;
    cursor: pointer;
    box-shadow: var(--shadow-1);
  }
  .tip-jar:hover { color: var(--c-ink); border-color: var(--c-accent); }
  .tip-panel {
    border: 1px solid var(--c-rule);
    background: var(--c-bg-raised);
    color: var(--c-ink);
    border-radius: var(--radius-2);
    padding: var(--s-5);
    width: min(360px, 92vw);
    max-width: 92vw;
  }
  .tip-panel::backdrop { background: rgba(0,0,0,0.5); }
  .tip-panel header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: var(--s-3); }
  .tip-panel h2 { margin: 0; font-size: 1.05rem; }
  .close { background: none; border: none; color: var(--c-ink-faint); cursor: pointer; font-size: 1rem; }
  .ask { color: var(--c-ink-dim); margin: 0 0 var(--s-4); font-size: 0.95rem; }
  .options { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-2); }
  .opt {
    display: grid; grid-template-columns: 36px 1fr; gap: var(--s-3); align-items: center;
    padding: var(--s-3) var(--s-4);
    background: var(--c-surface);
    border: 1px solid var(--c-rule);
    border-radius: var(--radius-1);
    color: var(--c-ink);
    text-decoration: none;
  }
  .opt:hover { border-color: var(--c-accent); color: var(--c-accent); text-decoration: none; }
  .opt small { display: block; color: var(--c-ink-faint); margin-top: 2px; }
  .coin {
    width: 30px; height: 30px; border-radius: 999px;
    display: grid; place-items: center;
    font-family: var(--font-serif); font-style: italic;
    border: 1px solid currentColor;
  }
  .coin-gold { color: #d4a64a; }
  .coin-plat { color: #b8c1c8; }
  .coin-custom { color: var(--c-ink-dim); }
  .not-configured { color: var(--c-ink-faint); font-size: 0.85rem; line-height: 1.55; }
</style>

<script>
  const dlg = document.getElementById('tip-jar-panel') as HTMLDialogElement;
  const btn = document.getElementById('tip-jar-toggle')!;
  const close = document.getElementById('tip-close')!;
  btn.addEventListener('click', () => {
    btn.setAttribute('aria-expanded', 'true');
    if (typeof dlg.showModal === 'function') dlg.showModal();
    else dlg.setAttribute('open', '');
  });
  close.addEventListener('click', () => {
    btn.setAttribute('aria-expanded', 'false');
    dlg.close();
  });
  dlg.addEventListener('close', () => btn.setAttribute('aria-expanded', 'false'));
</script>
