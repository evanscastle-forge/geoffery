---
/*
 * The Butler's Bell consultation (D-011).
 *
 * One `<dialog>` containing five rendered panels (pick-item, pick-side,
 * pick-tolerance, show-recommendation, limit-reached). A tiny JS state
 * machine inside the script tag drives transitions between them.
 *
 * Data: the script lazily fetches /items.json and /api/consult once the
 * dialog opens. The recommendation comes from /aggregates.json which is
 * already bundled with the site at build time. The /api/consult POST is
 * fire-and-forget — UX never blocks on it. (The Cloudflare D1 endpoint
 * lands in Phase 3; until then the POST hits 404 silently, which is
 * the correct fail-open behaviour per the spec.)
 *
 * Soft meter: localStorage key `gf.bell.<yyyy-mm-dd>` increments per
 * consultation; >= 5 in a day → limit-reached panel. UTC day.
 */
import lines from '../content/geoffery-lines.json';
---

<dialog id="consultation-panel" class="consult" aria-labelledby="consult-title">
  <div class="consult-frame">
    <button class="consult-close" id="consult-close" aria-label="Close consultation">✕</button>

    {/* Each <section data-node> is one tree node; JS toggles `hidden`. */}

    <section data-node="pick-item" hidden>
      <div class="said">
        <p class="name">Geoffery</p>
        <p class="line">{lines.consult_greeting_no_item}</p>
      </div>
      <input
        type="search"
        id="consult-item-input"
        placeholder="Name an item, sir."
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
      />
      <ul id="consult-item-results" class="consult-results" hidden></ul>
    </section>

    <section data-node="pick-side" hidden>
      <div class="said">
        <p class="name">Geoffery</p>
        <p class="line" data-item-greeting></p>
      </div>
      <div class="consult-options">
        <button class="consult-opt" data-side="buy">{lines.consult_choose_buy}</button>
        <button class="consult-opt" data-side="sell">{lines.consult_choose_sell}</button>
      </div>
    </section>

    <section data-node="pick-tolerance" hidden>
      <div class="said">
        <p class="name">Geoffery</p>
        <p class="line" data-tolerance-prompt></p>
      </div>
      <div class="consult-options">
        <button class="consult-opt" data-tolerance="instant" data-opt-buy={lines.buy_opt_instant} data-opt-sell={lines.sell_opt_instant}></button>
        <button class="consult-opt" data-tolerance="hours" data-opt-buy={lines.buy_opt_hours} data-opt-sell={lines.sell_opt_hours}></button>
        <button class="consult-opt" data-tolerance="patient" data-opt-buy={lines.buy_opt_patient} data-opt-sell={lines.sell_opt_patient}></button>
      </div>
    </section>

    <section data-node="show-recommendation" hidden>
      <div class="said">
        <p class="name">Geoffery</p>
        <p class="line" data-recommendation></p>
        <p class="regime" data-regime></p>
        <p class="news-ack" data-news-ack hidden></p>
        <p class="confidence" data-confidence></p>
      </div>
      <div class="consult-options">
        <a class="consult-opt" data-item-link href="#">{lines.consult_close}</a>
      </div>
    </section>

    <section data-node="limit-reached" hidden>
      <div class="said">
        <p class="name">Geoffery</p>
        <p class="line">{lines.bell_limit_reached}</p>
        <p class="confidence">{lines.bell_limit_supporter_hint}</p>
      </div>
      <div class="consult-options">
        <a class="consult-opt" href="/tip-jar">A coin in the jar</a>
        <button class="consult-opt" data-action="dismiss">Very good, sir.</button>
      </div>
    </section>
  </div>
</dialog>

<style>
  .consult {
    border: none;
    background: transparent;
    padding: 0;
    max-width: 92vw;
    width: 540px;
  }
  .consult::backdrop { background: rgba(0, 0, 0, 0.55); }
  .consult-frame {
    position: relative;
    background: var(--c-parchment);
    color: var(--c-parchment-ink);
    border: 2px solid var(--c-parchment-rule);
    border-radius: var(--radius-1);
    padding: var(--s-5) var(--s-5) var(--s-4);
  }
  .consult-close {
    position: absolute;
    top: var(--s-2);
    right: var(--s-3);
    background: transparent;
    border: none;
    color: var(--c-parchment-ink-faint);
    font-size: 1rem;
    cursor: pointer;
  }
  .consult-close:hover { color: var(--c-parchment-red); }

  .said { display: grid; gap: var(--s-2); }
  .said .name {
    font-family: var(--font-serif);
    font-weight: 600;
    color: var(--c-parchment-red);
    font-size: 1.05rem;
    margin: 0;
  }
  .said .line {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.4;
    margin: 0;
  }
  .said .regime {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--c-parchment-ink-dim);
    margin: var(--s-1) 0 0;
  }
  .said .confidence {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--c-parchment-ink-faint);
    margin: var(--s-1) 0 0;
  }
  .said .news-ack {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--c-parchment-red);
    margin: var(--s-2) 0 0;
    font-size: 0.95rem;
  }

  #consult-item-input {
    margin-top: var(--s-4);
    width: 100%;
    padding: var(--s-2) var(--s-3);
    font: inherit;
    background: var(--c-parchment-raised);
    color: var(--c-parchment-ink);
    border: 1px solid var(--c-parchment-rule);
    border-radius: var(--radius-1);
  }
  .consult-results {
    list-style: none;
    margin: var(--s-2) 0 0;
    padding: 0;
    max-height: 220px;
    overflow-y: auto;
    border-top: 1px solid var(--c-parchment-rule-faint);
  }
  .consult-results li { border-bottom: 1px solid var(--c-parchment-rule-faint); }
  .consult-results li:last-child { border-bottom: none; }
  .consult-results a {
    display: block;
    padding: var(--s-2) var(--s-3);
    color: var(--c-parchment-ink);
    text-decoration: none;
  }
  .consult-results a:hover, .consult-results a[aria-selected="true"] {
    background: var(--c-parchment-raised);
    color: var(--c-parchment-red);
  }

  .consult-options {
    margin-top: var(--s-4);
    display: grid;
    gap: var(--s-2);
  }
  .consult-opt {
    text-align: left;
    background: transparent;
    color: var(--c-parchment-link, #22468f);
    border: 1px solid transparent;
    border-radius: var(--radius-1);
    padding: var(--s-2) var(--s-3);
    font: inherit;
    font-family: var(--font-serif);
    font-size: 1rem;
    cursor: pointer;
    text-decoration: none;
  }
  .consult-opt:hover {
    background: var(--c-parchment-raised);
    border-color: var(--c-parchment-rule-faint);
    text-decoration: underline;
  }
  .consult-opt:focus-visible { outline: 2px solid var(--c-parchment-red); outline-offset: 1px; }
</style>

<script define:vars={{ lines }}>
  type Side = 'buy' | 'sell';
  type Tolerance = 'instant' | 'hours' | 'patient';
  type Item = { id: number; slug: string; name: string };

  const DAY_LIMIT = 5;

  const dlg = document.getElementById('consultation-panel') as HTMLDialogElement;
  const close = document.getElementById('consult-close')!;

  const trigger = document.getElementById('bell-trigger');

  const state: {
    item: Item | null;
    side: Side | null;
    tolerance: Tolerance | null;
  } = { item: null, side: null, tolerance: null };

  let items: Item[] = [];
  let aggregates: Record<string, any> = {};
  let calibration: Record<string, { fill_rate: number; n_total: number }> = {};

  function show(node: string) {
    dlg.querySelectorAll<HTMLElement>('section[data-node]').forEach((s) => {
      s.hidden = s.dataset.node !== node;
    });
  }

  function dayKey(): string {
    const d = new Date();
    return `gf.bell.${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}-${String(d.getUTCDate()).padStart(2, '0')}`;
  }

  function getDayCount(): number {
    try {
      return Number(localStorage.getItem(dayKey()) || '0');
    } catch { return 0; }
  }

  function bumpDayCount(): number {
    const n = getDayCount() + 1;
    try { localStorage.setItem(dayKey(), String(n)); } catch {}
    return n;
  }

  async function ensureCatalogs() {
    if (items.length === 0) {
      const [iRes, aRes] = await Promise.all([
        fetch('/items.json').then((r) => r.json()).catch(() => []),
        fetch('/aggregates.json').then((r) => r.ok ? r.json() : {}).catch(() => ({})),
      ]);
      items = iRes;
      aggregates = aRes;
    }
  }

  function pickItemFromPage(): Item | null {
    const slug = document.body.dataset.itemSlug || '';
    const name = document.body.dataset.itemName || '';
    const id = Number(document.body.dataset.itemId || '0');
    if (slug && name && id) return { slug, name, id };
    return null;
  }

  function openAt(initial: 'pick-item' | 'pick-side' | 'limit-reached') {
    if (typeof dlg.showModal === 'function') dlg.showModal(); else dlg.setAttribute('open', '');
    show(initial);
    if (initial === 'pick-side') {
      const el = dlg.querySelector('[data-item-greeting]') as HTMLElement;
      el.textContent = (lines.consult_greeting_item_context as string)
        .replace('{item}', state.item!.name);
    }
    if (initial === 'pick-item') {
      const input = document.getElementById('consult-item-input') as HTMLInputElement;
      input.value = '';
      (document.getElementById('consult-item-results') as HTMLUListElement).hidden = true;
      setTimeout(() => input.focus(), 0);
    }
  }

  trigger?.addEventListener('click', async () => {
    if (getDayCount() >= DAY_LIMIT) {
      if (typeof dlg.showModal === 'function') dlg.showModal();
      show('limit-reached');
      return;
    }
    await ensureCatalogs();
    state.item = pickItemFromPage();
    state.side = null;
    state.tolerance = null;
    openAt(state.item ? 'pick-side' : 'pick-item');
  });

  close.addEventListener('click', () => dlg.close());
  dlg.addEventListener('cancel', () => dlg.close());
  dlg.querySelector('[data-action="dismiss"]')?.addEventListener('click', () => dlg.close());

  // ── pick-item ─────────────────────────────────────────────────────────
  const itemInput = document.getElementById('consult-item-input') as HTMLInputElement;
  const itemResults = document.getElementById('consult-item-results') as HTMLUListElement;
  function scoreItem(name: string, q: string): number {
    name = name.toLowerCase();
    if (name === q) return 1000;
    if (name.startsWith(q)) return 500 + (100 - name.length);
    const idx = name.indexOf(q);
    if (idx >= 0) return 200 - idx;
    return -1;
  }
  itemInput?.addEventListener('input', () => {
    const q = itemInput.value.trim().toLowerCase();
    if (!q) { itemResults.hidden = true; itemResults.innerHTML = ''; return; }
    const scored = items
      .map((it) => [scoreItem(it.name, q), it] as [number, Item])
      .filter(([s]) => s > 0)
      .sort((a, b) => b[0] - a[0])
      .slice(0, 8);
    itemResults.hidden = scored.length === 0;
    itemResults.innerHTML = scored.map(([_, it]) =>
      `<li><a href="#" data-id="${it.id}" data-slug="${it.slug}" data-name="${it.name.replace(/"/g, '&quot;')}">${it.name}</a></li>`
    ).join('');
  });
  itemResults?.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-slug]');
    if (!a) return;
    e.preventDefault();
    state.item = { id: Number(a.dataset.id), slug: a.dataset.slug!, name: a.dataset.name! };
    openAt('pick-side');
  });

  // ── pick-side ─────────────────────────────────────────────────────────
  dlg.querySelectorAll<HTMLButtonElement>('button[data-side]').forEach((b) => {
    b.addEventListener('click', () => {
      state.side = b.dataset.side as Side;
      // populate tolerance buttons with side-specific copy
      const prompt = dlg.querySelector('[data-tolerance-prompt]') as HTMLElement;
      prompt.textContent = state.side === 'buy'
        ? (lines.buy_pick_tolerance as string)
        : (lines.sell_pick_tolerance as string);
      dlg.querySelectorAll<HTMLButtonElement>('button[data-tolerance]').forEach((tb) => {
        tb.textContent = (state.side === 'buy' ? tb.dataset.optBuy : tb.dataset.optSell) || '';
      });
      show('pick-tolerance');
    });
  });

  // ── pick-tolerance ────────────────────────────────────────────────────
  function recommendationFor(slug: string, side: Side, tolerance: Tolerance): { price: number | null; bucket: string; regimeKey: string } {
    const agg = aggregates[slug];
    if (!agg) return { price: null, bucket: '', regimeKey: '' };
    const price = agg.recommendations?.[tolerance]?.[side] ?? null;
    const r = agg.regime || {};
    const liquidity = r.liquidity || 'medium';
    const stability = r.stability || 'steady';
    const power = r.power || 'balanced';
    return {
      price,
      bucket: `${tolerance}/${side}/${liquidity}/${stability}`,
      regimeKey: `regime_${power}_${stability}`,
    };
  }

  function formatGp(n: number | null): string {
    if (n == null) return '—';
    return n.toLocaleString('en-US') + ' gp';
  }

  dlg.querySelectorAll<HTMLButtonElement>('button[data-tolerance]').forEach((b) => {
    b.addEventListener('click', async () => {
      state.tolerance = b.dataset.tolerance as Tolerance;
      const rec = recommendationFor(state.item!.slug, state.side!, state.tolerance!);

      // Pick the right recommendation copy line
      const lineKey = `${state.side}_rec_${state.tolerance}`;
      const recCopy: string = (rec.price === null)
        ? (lines.consult_recommendation_soft as string).replace('{price}', '—')
        : (lines as any)[lineKey].replace('{price}', formatGp(rec.price));
      const regimeCopy: string = (lines as any)[rec.regimeKey] || '';

      const cal = calibration[rec.bucket];
      let confCopy = lines.consult_confidence_low as string;
      if (cal && cal.n_total >= 50) {
        const pct = Math.round(cal.fill_rate * 100);
        confCopy = ((cal.fill_rate >= 0.8) ? lines.consult_confidence_high : lines.consult_confidence_mid)
          .toString().replace('{pct}', String(pct));
      }

      (dlg.querySelector('[data-recommendation]') as HTMLElement).textContent = recCopy;
      (dlg.querySelector('[data-regime]') as HTMLElement).textContent = regimeCopy;
      (dlg.querySelector('[data-confidence]') as HTMLElement).textContent = confCopy;

      // D-013 × D-011 cross: when an item carries wiki update notices, the
      // consultation acknowledges them briefly (still neutral, never directional).
      const ackEl = dlg.querySelector<HTMLElement>('[data-news-ack]')!;
      const notices = (aggregates[state.item!.slug]?.wiki_update_notices ?? []) as Array<{ kind: 'upcoming' | 'recent' | 'past' }>;
      if (notices.length > 0) {
        const upcoming = notices.some((n) => n.kind === 'upcoming');
        const phrasing = upcoming ? 'an upcoming Jagex update' : 'a recent Jagex update';
        ackEl.textContent = (lines.consult_news_acknowledged as string).replace('{kind_phrasing}', phrasing);
        ackEl.hidden = false;
      } else {
        ackEl.textContent = '';
        ackEl.hidden = true;
      }

      const itemLink = dlg.querySelector('[data-item-link]') as HTMLAnchorElement;
      itemLink.href = `/item/${state.item!.slug}#consulted=${encodeURIComponent(rec.bucket)}-${rec.price ?? 0}`;

      bumpDayCount();

      // Fire-and-forget log to the edge. Phase 3 wires this up; until then
      // it 404s and we don't care — the UX has already rendered.
      try {
        const cid = localStorage.getItem('gf.cid') || cryptoUUID();
        localStorage.setItem('gf.cid', cid);
        fetch('/api/consult', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            client_id: cid,
            item_id: state.item!.id,
            side: state.side,
            tolerance: state.tolerance,
            recommended_price: rec.price,
            confidence_bucket: rec.bucket,
          }),
        }).catch(() => {});
      } catch {}

      show('show-recommendation');
    });
  });

  function cryptoUUID(): string {
    try {
      // @ts-ignore — modern browsers
      if (typeof crypto?.randomUUID === 'function') return crypto.randomUUID();
    } catch {}
    return Math.random().toString(36).slice(2) + Date.now().toString(36);
  }

  // Load calibration once when the dialog first opens.
  trigger?.addEventListener('click', async () => {
    if (Object.keys(calibration).length === 0) {
      try {
        const res = await fetch('/methodology-stats.json');
        if (res.ok) {
          const j = await res.json();
          calibration = j.cohorts || {};
        }
      } catch {}
    }
  }, { once: true });
</script>
