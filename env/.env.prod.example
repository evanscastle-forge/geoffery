# env/.env.prod — deploy config for `ops/run.sh prod` (geoffery.gg).
# Copy to env/.env.prod and fill in. Mechanically identical to env/.env.dev —
# only the labels + origin differ ("works in dev ⇒ works in prod").
#
# Secrets rule: never paste a secret into chat. Fill values here directly, or run
# `wrangler login` once. Worker secrets (ANTHROPIC_API_KEY) go via
# `ops/run.sh prod secret <NAME> <worker>`, never stored here.

# Pinned by run.sh's preflight — must equal the target ("prod").
GEOFFERY_DEPLOYMENT_NAME=prod
GEOFFERY_SITE_URL=https://geoffery.gg
GEOFFERY_USER_AGENT="Geoffery (contact@evancastle.com)"

# Cloudflare account + zone (required by the deploy preflight).
CLOUDFLARE_ACCOUNT_ID=
GEOFFERY_ZONE=geoffery.gg

# API token (OPTIONAL — prefer `wrangler login`). If set, it is a secret: fill in
# your editor, never in chat.
CLOUDFLARE_API_TOKEN=

GEOFFERY_NEWS_CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# D1/R2/KV ids live in ops/wrangler/*.toml under [env.prod] (search
# REPLACE_WITH_PROD_). Create them with `wrangler d1 create geoffery-prod` /
# `wrangler r2 bucket create geoffery-archive-prod`.
