---
/*
 * D-013 wiki-update notice block on item pages.
 *
 * Neutral, hedged, never directional ("will rise/fall") and never
 * advisory ("buy before Wednesday"). Each notice carries an explicit
 * provenance link to the OSRS Wiki article — the disclosure that lets
 * us avoid republishing CC BY-NC-SA content while still using it as a
 * signal.
 *
 * `summary` is always our own short factual phrasing (extracted in
 * pipeline `wiki_news.short_summary`); the original wiki text is
 * stored only as classification provenance and never rendered to users.
 */
import lines from '../content/geoffery-lines.json';
import type { WikiUpdateNotice } from '../lib/data';

type Props = { notices: WikiUpdateNotice[] };
const { notices } = Astro.props;

const phrasingFor = (kind: WikiUpdateNotice['kind']) =>
  kind === 'upcoming' ? lines.wiki_notice_upcoming : lines.wiki_notice_recent;
---

{notices.length > 0 && (
  <section class="panel wiki-notices" aria-label="Update notices">
    <h2>Geoffery's notice</h2>
    {notices.map((n) => (
      <article class={`notice notice-${n.kind}`}>
        <p class="line"><strong>{phrasingFor(n.kind)}</strong> {n.summary}</p>
        <p class="prov ui">
          <a href={n.url} target="_blank" rel="noopener">{lines.wiki_notice_provenance}: {n.title}</a>
        </p>
      </article>
    ))}
    <p class="caveat ui muted">{lines.wiki_no_speculation}</p>
  </section>
)}

<style>
  .wiki-notices { margin-top: var(--s-4); }
  .wiki-notices h2 { margin-top: 0; }
  .notice {
    padding: var(--s-3) var(--s-4);
    border-left: 3px solid var(--c-parchment-rule);
    margin: var(--s-3) 0;
  }
  .notice-upcoming { border-left-color: var(--c-accent); }
  .notice-recent   { border-left-color: var(--c-parchment-red); }
  .notice .line { margin: 0; font-family: var(--font-serif); font-size: 1.02rem; }
  .notice .prov { margin: var(--s-1) 0 0; font-size: 0.78rem; }
  .caveat { margin-top: var(--s-3); font-style: italic; }
  .muted  { color: var(--c-parchment-ink-faint); }
</style>
