---
/*
 * D-016 reserved-dimension ad container.
 *
 * Every ad slot is a fixed-dimension box that exists in the layout
 * whether or not an ad fills it — cumulative layout shift from
 * advertising must be ZERO (D-016c, binding).
 *
 * At MVP the slot renders a small parchment placeholder so the
 * positioning is visible during build-out. When AdSense onboards,
 * the placeholder is swapped for the network's tag inside the same
 * container. Four kinds (D-016b, binding):
 *   - "item-mid"    : horizontal unit BELOW the verdict/gauge block
 *                     (desktop only; mobile collapses to single slot)
 *   - "item-bottom" : page-bottom unit on item pages
 *   - "page-bottom" : single bottom unit on methodology / tip-jar
 *                     (zero or one max per D-016b)
 *   - "mobile-only" : the single mobile in-content unit
 *
 * NOTE: prop is named `kind`, not `slot` — `slot` is Astro's reserved
 * named-slot projection attribute and would silently no-op the
 * component invocation.
 */
export interface Props {
  kind: 'item-mid' | 'item-bottom' | 'page-bottom' | 'mobile-only';
}
const { kind } = Astro.props;

const sizes: Record<string, { w: number; h: number; mobile: 'show' | 'hide' | 'only' }> = {
  'item-mid':    { w: 728, h: 90,  mobile: 'hide' },
  'item-bottom': { w: 728, h: 90,  mobile: 'hide' },
  'page-bottom': { w: 728, h: 90,  mobile: 'hide' },
  'mobile-only': { w: 320, h: 100, mobile: 'only' },
};
const s = sizes[kind];
---

<aside
  class:list={['ad-slot', `ad-${kind}`, `ad-mobile-${s.mobile}`]}
  data-kind={kind}
  aria-label="Advertisement"
  style={`min-width:${s.w}px; min-height:${s.h}px;`}
>
  <span class="ad-tag">Ad</span>
</aside>

<style>
  .ad-slot {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: var(--s-5) auto;
    border: 1px dashed var(--c-rule);
    color: var(--c-ink-faint);
    background: transparent;
    max-width: 100%;
    width: 100%;
  }
  .ad-tag {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--c-ink-faint);
  }
  @media (max-width: 600px) {
    .ad-mobile-hide { display: none !important; }
  }
  @media (min-width: 601px) {
    .ad-mobile-only { display: none !important; }
  }
  body[data-supporter="1"] .ad-slot { display: none !important; }
</style>
