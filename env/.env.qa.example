# Geoffery — qa environment (.env.qa)
#
# Source: scripts/run.sh qa <cmd>
# Posture: a mechanically identical mirror of prod, except for the env file
# loaded and the deployment label that flips the noindex / robots-deny
# posture and disables the live tip jar. The qa zone itself is hidden
# from the public via Cloudflare Access (Zero Trust) — see
# docs/deployments.md for the access-app config.
#
# Default subdomain piggybacks on the operator's existing evanscastle-forge.com
# Cloudflare zone. Swap if you point a real subdomain.

GEOFFERY_DEPLOYMENT_NAME=qa
GEOFFERY_SITE_URL=https://geoffery.evanscastle-forge.com
GEOFFERY_DB=/srv/geoffery/qa/data/geoffery.db
GEOFFERY_USER_AGENT="Geoffery qa (evanscastle.forge@gmail.com)"

# Tip jar — STAYS unconfigured in qa. The locked-monetization promise
# (charter constraint 2) and the no-real-money-on-qa rule (this file's
# posture) require live payment links to live only in prod. The tip jar
# component renders a "qa preview" notice when DEPLOYMENT_NAME != prod.
PUBLIC_STRIPE_TIP_GOLD_URL=
PUBLIC_STRIPE_TIP_PLATINUM_URL=
PUBLIC_STRIPE_TIP_CUSTOM_URL=
