---
import type { Aggregate } from '../lib/data';
type Props = { agg: Aggregate };
const { agg } = Astro.props;
const band = agg.band;
const pctMarker = (() => {
  if (band === 'unsettled' || agg.percentile == null) return null;
  return Math.max(0.02, Math.min(0.98, agg.percentile));
})();

const bandLabel: Record<string, string> = {
  good: 'Good',
  average: 'Average',
  poor: 'Poor',
  unsettled: 'Unsettled',
};
---

<section class={`gauge gauge-${band}`} aria-label="Deal gauge">
  <header class="gauge-head">
    <span class="badge ui">{bandLabel[band]}</span>
    <p class="verdict">{agg.verdict_text}</p>
  </header>
  {pctMarker !== null && (
    <>
      <div class="band" aria-hidden="true">
        <span class="seg seg-good" />
        <span class="seg seg-average" />
        <span class="seg seg-poor" />
        <span class="marker" style={`left: ${(pctMarker * 100).toFixed(2)}%;`} />
      </div>
      <p class="legend ui">
        <span>Below 30-day median</span>
        <span>Above 30-day median</span>
      </p>
    </>
  )}
  {band === 'unsettled' && (
    <p class="unsettled-note">{agg.flags.includes('thin-history')
      ? 'I have not yet kept the ledger long enough to appraise this item.'
      : 'The market is unsettled; readings may shift swiftly.'}</p>
  )}
</section>

<style>
  .gauge {
    padding: var(--s-5) 0 var(--s-4);
    margin: var(--s-4) 0 0;
    border-top: 1px solid var(--c-rule);
  }
  .gauge-head {
    display: flex;
    gap: var(--s-5);
    align-items: baseline;
    flex-wrap: wrap;
  }
  .badge {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-weight: 600;
    border-bottom: 2px solid currentColor;
    padding-bottom: 2px;
    flex-shrink: 0;
  }
  .gauge-good   .badge { color: var(--c-good); }
  .gauge-average .badge { color: var(--c-average); }
  .gauge-poor   .badge { color: var(--c-poor); }
  .gauge-unsettled .badge { color: var(--c-unsettled); }
  .verdict {
    margin: 0;
    flex: 1 1 14rem;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-style: italic;
    line-height: 1.4;
    color: var(--c-ink);
  }
  .band {
    margin-top: var(--s-5);
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    height: 4px;
  }
  .seg-good    { background: color-mix(in oklab, var(--c-good) 55%, transparent); }
  .seg-average { background: color-mix(in oklab, var(--c-average) 55%, transparent); }
  .seg-poor    { background: color-mix(in oklab, var(--c-poor) 55%, transparent); }
  .marker {
    position: absolute; top: -6px; bottom: -6px; width: 2px;
    background: var(--c-ink);
    transform: translateX(-1px);
  }
  .legend {
    display: flex; justify-content: space-between;
    color: var(--c-ink-faint);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin: var(--s-3) 0 0;
  }
  .unsettled-note {
    color: var(--c-ink-dim);
    font-style: italic;
    font-size: 1rem;
    margin: var(--s-3) 0 0;
  }
</style>
