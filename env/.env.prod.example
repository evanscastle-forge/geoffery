# Geoffery — prod environment (.env.prod)
#
# Source: scripts/run.sh prod <cmd>
# Posture: public production. Identical code path to qa; this file is the
# only thing that changes (env values + the deployment label).

GEOFFERY_DEPLOYMENT_NAME=prod
GEOFFERY_SITE_URL=https://geoffery.gg
GEOFFERY_DB=/srv/geoffery/prod/data/geoffery.db
GEOFFERY_USER_AGENT="Geoffery (evanscastle.forge@gmail.com)"

# Tip jar — only set these to live Stripe Payment Link URLs in .env.prod.
# Do NOT paste raw values into chat; edit the file directly. The tip jar
# is the ONLY surface where a real payment link is permitted.
PUBLIC_STRIPE_TIP_GOLD_URL=https://buy.stripe.com/REPLACE_ME_GOLD
PUBLIC_STRIPE_TIP_PLATINUM_URL=https://buy.stripe.com/REPLACE_ME_PLATINUM
PUBLIC_STRIPE_TIP_CUSTOM_URL=https://buy.stripe.com/REPLACE_ME_CUSTOM
