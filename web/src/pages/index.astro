---
import Base from '../layouts/Base.astro';
import Dialogue from '../components/Dialogue.astro';
import Search from '../components/Search.astro';
import lines from '../content/geoffery-lines.json';
import { aggregates, meta } from '../lib/data';

const sample = Object.values(aggregates)
  .filter((a) => a.band !== 'unsettled' && a.volume_24h > 0)
  .sort((a, b) => b.volume_24h - a.volume_24h)
  .slice(0, 8);
const settled = Object.values(aggregates).filter((a) => a.band !== 'unsettled').length;
const total = Object.values(aggregates).length;
const exportedISO = new Date(meta.exported_at * 1000).toISOString();
const bandWord: Record<string, string> = {
  good: 'good',
  average: 'average',
  poor: 'poor',
  unsettled: 'unsettled',
};
---

<Base title={`Geoffery — ${lines.tagline_long}`} description={lines.tagline_long}>
  <Dialogue text={lines.homepage_intro} />

  <Search />

  <p class="lede ui">
    <span>{settled.toLocaleString()} of {total.toLocaleString()} items appraised</span>
    <span class="sep" aria-hidden="true">·</span>
    <time datetime={exportedISO}>Exported {exportedISO.slice(0, 10)}</time>
  </p>

  {sample.length > 0 && (
    <section>
      <h2>What the household is checking</h2>
      <ol class="watchlist">
        {sample.map((a, i) => (
          <li>
            <span class="num ui">{String(i + 1).padStart(2, '0')}</span>
            <a href={`/item/${a.slug}`} class="name">{a.name}</a>
            <span class={`band band-${a.band} ui`}>{bandWord[a.band]}</span>
            <span class="verdict">{a.verdict_text}</span>
          </li>
        ))}
      </ol>
    </section>
  )}

  <section>
    <h2>How Geoffery appraises</h2>
    <p>
      For each item, Geoffery records every five-minute price the Grand Exchange yields,
      across thirty days, weighted by volume. The current price's place in that
      distribution is the verdict — <em>good</em> (below the interquartile range),
      <em>average</em> (within), or <em>poor</em> (above). When volume or volatility
      spike, or Jagex publishes news that touches the market, Geoffery marks the
      figures <em>unsettled</em> and declines to stake his wages on them.
    </p>
    <p><a href="/methodology">Read the methodology in full →</a></p>
  </section>
</Base>

<style>
  .lede {
    color: var(--c-ink-faint);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin: var(--s-6) 0 0;
    display: flex;
    gap: var(--s-3);
    flex-wrap: wrap;
  }
  .lede .sep { color: var(--c-rule); }

  .watchlist {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .watchlist li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas:
      "num name band"
      "num verdict verdict";
    column-gap: var(--s-4);
    row-gap: var(--s-1);
    align-items: baseline;
    padding: var(--s-4) 0;
    border-bottom: 1px solid var(--c-rule);
  }
  .watchlist li:last-child { border-bottom: none; }
  .num {
    grid-area: num;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--c-ink-faint);
    font-variant-numeric: tabular-nums;
    align-self: start;
    padding-top: 0.35em;
  }
  .name {
    grid-area: name;
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--c-ink);
    text-decoration: none;
    line-height: 1.25;
  }
  .name:hover { color: var(--c-accent); text-decoration: none; }
  .band {
    grid-area: band;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
    align-self: center;
  }
  .band-good     { color: var(--c-good); }
  .band-average  { color: var(--c-average); }
  .band-poor     { color: var(--c-poor); }
  .band-unsettled{ color: var(--c-unsettled); }
  .verdict {
    grid-area: verdict;
    color: var(--c-ink-dim);
    font-size: 0.95rem;
    font-style: italic;
  }
</style>
