# Geoffery — local environment. Copy to .env and fill in.
# Never paste secrets into chat; edit this file directly.

GEOFFERY_DEPLOYMENT_NAME=local
GEOFFERY_SITE_URL=http://127.0.0.1:4321
GEOFFERY_USER_AGENT="Geoffery local-dev (evanscastle.forge@gmail.com)"

# Local storage roots (R2 + D1 stand-ins).
GEOFFERY_ARCHIVE_DIR=./.data/archive
GEOFFERY_DB=./.data/geoffery.db

# Reference repo (read-only) — Phase 0 migration source.
GEOFFERY_LEGACY_DB=../geoffery_old/data/geoffery.db

# Consult worker port.
GEOFFERY_CONSULT_PORT=8787

# News classifier (optional). Without a key, updates simply lack annotations.
# Add it here directly — do not paste into chat.
ANTHROPIC_API_KEY=
GEOFFERY_NEWS_CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# Tip jar (informational-only at MVP; live links are prod).
PUBLIC_STRIPE_TIP_GOLD_URL=
PUBLIC_STRIPE_TIP_PLATINUM_URL=
PUBLIC_STRIPE_TIP_CUSTOM_URL=
