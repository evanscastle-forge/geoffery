---
import Base from "../layouts/Base.astro";
import Saying from "../components/Saying.astro";
import { PAGES } from "@geoffery/content";

// The About page speaks directly to the reader (owner directive 2026-06-14):
// plainer and more serious than the rest of the house — no in-character chatbox.
const A = PAGES.about;
const CONTACT_MAILTO = "mailto:support@geoffery.gg";
---

<Base title="About Geoffery — OSRS Grand Exchange price guide" description="What Geoffery is, how it rates prices and recommends offers, who makes it, and how to get in touch." canonicalPath="/about/">
  <div class="wrap measure">
    <h1>{A.title}</h1>
    <Saying page="about" />
    <p class="lede">{A.intro}</p>

    <section class="panel doc">
      <h2>{A.whatHeading}</h2>
      <p>{A.whatBody}</p>

      <h2>{A.bellHeading}</h2>
      <p>{A.bellBody}</p>

      <h2>{A.whoHeading}</h2>
      <p>{A.whoBody}</p>

      <h2>{A.contactHeading}</h2>
      <p>{A.contactBody}</p>
      <p class="cta-row"><a class="contact-cta" href={CONTACT_MAILTO}>{A.contactCta}</a></p>
    </section>
  </div>
</Base>

<style>
  .lede { color: var(--paper-text); font-size: 1.12rem; line-height: 1.6; margin: var(--s-4) 0 0; }
  .doc { margin-top: var(--s-5); }
  .doc h2 { margin-top: var(--s-5); }
  /* Centered email button (owner feedback 2026-06-14). */
  .cta-row { margin-top: var(--s-5); text-align: center; }
  .contact-cta {
    display: inline-block; padding: 10px 18px; border-radius: var(--radius);
    background: var(--brass); color: #1c1709; font-weight: 700;
  }
  .contact-cta:hover { text-decoration: none; filter: brightness(1.05); }
</style>
