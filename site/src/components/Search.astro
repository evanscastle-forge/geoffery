---
// Instant, forgiving item search (spec §4) — the primary entry point. Fetches the
// static search index and links to item pages. No server at request time.
import { HOME } from "@geoffery/content";
---
<div class="search" role="search">
  <input id="site-search" type="search" autocomplete="off" placeholder={HOME.searchPlaceholder} aria-label="Search items" />
  <ul id="site-search-results" class="search-results" hidden></ul>
</div>

<script>
  import { initSearch } from "../scripts/search.ts";
  initSearch();
</script>

<style>
  .search { position: relative; }
  .search input {
    width: 100%; padding: 14px 16px; font-size: 1.1rem; border-radius: var(--radius);
    border: 1px solid var(--panel-edge); background: var(--panel); color: var(--ink);
  }
  .search-results {
    list-style: none; margin: 6px 0 0; padding: 6px; position: absolute; left: 0; right: 0; z-index: 30;
    background: var(--panel); color: var(--ink); border: 1px solid var(--panel-edge);
    border-radius: var(--radius); box-shadow: var(--shadow); max-height: 320px; overflow:auto;
  }
  .search-results li a { display:flex; justify-content: space-between; gap: var(--s-3); padding: 9px 10px; border-radius: var(--radius); color: var(--ink); }
  .search-results li a:hover { background: var(--panel-stripe); text-decoration: none; }
  .search-results li a > span:first-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
</style>
