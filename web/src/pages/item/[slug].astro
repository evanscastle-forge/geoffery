---
import Base from '../../layouts/Base.astro';
import Dialogue from '../../components/Dialogue.astro';
import Gauge from '../../components/Gauge.astro';
import Sparkline from '../../components/Sparkline.astro';
import lines from '../../content/geoffery-lines.json';
import { items, getAggregate, getSparkline, news } from '../../lib/data';
import { formatGp, formatVolume, timeAgo } from '../../lib/format';

export function getStaticPaths() {
  return items.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const agg = getAggregate(item.slug);
const spark = getSparkline(item.slug);
const recentNews = news.slice(0, 3);
const title = `${item.name} GE price & deal rating — Geoffery`;
const description = agg && agg.band !== 'unsettled' && agg.current_price
  ? `${item.name}: ${formatGp(agg.current_price)}. ${agg.verdict_text}`
  : `${item.name} on the OSRS Grand Exchange — current price and deal rating, kept by Geoffery.`;
const now = Date.now() / 1000;
const fresh = agg && agg.high_ts ? timeAgo(Math.max(agg.high_ts, agg.low_ts ?? 0), now) : 'unknown';
---

<Base title={title} description={description}>
  <p class="crumbs ui"><a href="/">Geoffery</a> <span aria-hidden="true">·</span> Ledger entry</p>
  <h1>
    {item.name}
    {item.members && <span class="members" title="Members item">★</span>}
  </h1>

  {agg ? (
    <section class="headline panel">
      <Gauge agg={agg} />

      <dl class="quote">
        <div>
          <dt class="ui">Insta-buy</dt>
          <dd>{formatGp(agg.high)}</dd>
        </div>
        <div>
          <dt class="ui">Insta-sell</dt>
          <dd>{formatGp(agg.low)}</dd>
        </div>
        <div>
          <dt class="ui">24h volume</dt>
          <dd>{formatVolume(agg.volume_24h)}</dd>
        </div>
        <div>
          <dt class="ui">Last quoted</dt>
          <dd>{fresh}</dd>
        </div>
      </dl>

      {agg.flags.length > 0 && (
        <ul class="flags">
          {agg.flags.includes('thin-history') && <li>{lines.thin_history}</li>}
          {agg.flags.includes('no-current-price') && <li>{lines.no_current_price}</li>}
          {agg.flags.includes('volume-spike') && <li>{lines.volume_spike}</li>}
          {agg.flags.includes('recent-news') && <li>{lines.recent_news}</li>}
        </ul>
      )}
    </section>
  ) : (
    <Dialogue text="I have not yet recorded a figure for this item, master." />
  )}

  {(spark['1d'] || spark['1w'] || spark['1m']) && (
    <section class="panel">
      <h2>Recent figures</h2>
      <div class="sparks">
        {spark['1d'] && <Sparkline points={spark['1d']} label="last 24 hours" />}
        {spark['1w'] && <Sparkline points={spark['1w']} label="last 7 days" />}
        {spark['1m'] && <Sparkline points={spark['1m']} label="last 30 days" />}
      </div>
    </section>
  )}

  {recentNews.length > 0 && (
    <section>
      <h2>Game news</h2>
      <ul class="news">
        {recentNews.map((n) => (
          <li>
            <a href={n.url} target="_blank" rel="noopener">{n.title}</a>
            <small class="ui muted"> · {timeAgo(n.published_at, now)}</small>
          </li>
        ))}
      </ul>
    </section>
  )}

  <hr />
  <p class="colophon ui">
    Item № {item.id} <span aria-hidden="true">·</span> <a href="/methodology">How Geoffery rates</a>
  </p>
</Base>

<style>
  .crumbs {
    color: var(--c-ink-faint);
    margin: 0 0 var(--s-3);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }
  .crumbs a { color: var(--c-ink-faint); text-decoration: none; }
  .crumbs a:hover { color: var(--c-accent); }
  .crumbs span { color: var(--c-rule); margin: 0 var(--s-2); }

  h1 .members {
    color: var(--c-accent-dim);
    font-size: 0.7em;
    font-weight: normal;
    vertical-align: middle;
    margin-left: var(--s-2);
  }

  .headline { margin: 0 0 var(--s-6); }

  .quote {
    margin: var(--s-5) 0 0;
    padding: var(--s-4) 0 0;
    border-top: 1px solid var(--c-parchment-rule-faint);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-4) var(--s-6);
  }
  @media (min-width: 600px) { .quote { grid-template-columns: repeat(4, 1fr); } }
  .quote > div { display: flex; flex-direction: column; gap: var(--s-1); }
  .quote dt {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--c-parchment-ink-faint);
    font-weight: 600;
  }
  .quote dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 500;
    color: var(--c-parchment-ink);
    font-variant-numeric: tabular-nums lining-nums;
    letter-spacing: -0.01em;
  }

  .flags {
    list-style: none;
    padding: 0;
    margin: var(--s-4) 0 0;
    color: var(--c-parchment-ink-dim);
    font-style: italic;
    font-size: 0.98rem;
  }
  .flags li { padding: var(--s-1) 0; }
  .flags li::before { content: "— "; color: var(--c-parchment-ink-faint); }

  .sparks { display: grid; gap: var(--s-5); margin-top: var(--s-3); }
  @media (min-width: 600px) { .sparks { grid-template-columns: repeat(3, 1fr); } }

  .news { list-style: none; padding: 0; margin: 0; }
  .news li {
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--c-rule);
    font-size: 1.05rem;
  }
  .news li:last-child { border-bottom: none; }
  .news a { color: var(--c-ink); text-decoration: none; }
  .news a:hover { color: var(--c-accent); }
  .muted { color: var(--c-ink-faint); }

  .colophon {
    color: var(--c-ink-faint);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }
  .colophon span { color: var(--c-rule); margin: 0 var(--s-2); }
</style>
