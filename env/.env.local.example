# Geoffery — local environment (.env)
#
# Source: scripts/run.sh local <cmd>
# Posture: local SQLite at ./data/geoffery.db, http preview only, tip-jar
# disabled, robots noindex (local pages are never crawled anyway).
# Ephemeral secrets are fine.

GEOFFERY_DEPLOYMENT_NAME=local
GEOFFERY_SITE_URL=http://127.0.0.1:4321
GEOFFERY_DB=./data/geoffery.db
GEOFFERY_USER_AGENT="Geoffery local-dev (evanscastle.forge@gmail.com)"

# Tip jar — stays disabled in local. The UI shows a "the jar awaits its
# handles" notice instead of real Stripe links. Do NOT put live URLs here.
PUBLIC_STRIPE_TIP_GOLD_URL=
PUBLIC_STRIPE_TIP_PLATINUM_URL=
PUBLIC_STRIPE_TIP_CUSTOM_URL=
