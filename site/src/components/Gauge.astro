---
// The deal gauge (spec §4): rates the current price against the item's own
// trailing 30-day distribution. Horizontal band with a "you are here" marker.
// Action-first wording (buy/hold/sell/wait) — spec §4 tone rule reversed 2026-06-12.
import { GAUGE } from "@geoffery/content";
import type { AggregateView } from "../lib/data";

interface Props { agg: AggregateView; }
const { agg } = Astro.props;
const band = agg.band;
const g = GAUGE[band];

// Marker position from percentile (0..1). For unsettled / no data, hide marker.
const pct = agg.percentile;
const markerPos = pct == null ? null : Math.max(0, Math.min(1, pct)) * 100;
// Near the ends, the centred "current price" label would clip past the track — anchor
// it to that edge instead (owner feedback 2026-06-14).
const labelEdge = markerPos == null ? "" : markerPos < 12 ? "at-start" : markerPos > 88 ? "at-end" : "";

// IQR band as a fraction of the rendered track. We anchor the visual range to
// [p25*0.97 .. p75*1.03] so the shaded interquartile sits centrally; the marker
// is placed by percentile rank (its true position in the distribution).
const showBand = band !== "unsettled" && agg.p25 != null && agg.p75 != null;
---

<div class={`gauge gauge-${band}`}>
  <div class="gauge-head">
    <span class="gauge-verdict">{agg.verdictText}</span>
  </div>

  {showBand && (
    <div class="gauge-track" role="img" aria-label={`${g.label}. ${agg.verdictText}`}>
      <div class="gauge-iqr"></div>
      {markerPos != null && (
        <div class="gauge-marker" style={`left:${markerPos}%`}>
          <span class={`gauge-marker-label ${labelEdge}`}>{GAUGE.youAreHere}</span>
        </div>
      )}
    </div>
  )}

  {showBand && (
    <div class="gauge-scale small muted">
      <span>lower</span><span>higher</span>
    </div>
  )}
</div>

<style>
  .gauge { margin: var(--s-3) 0; }
  .gauge-head { display:flex; align-items:center; gap: var(--s-3); flex-wrap: wrap; margin-bottom: var(--s-3); }
  .gauge-verdict { color: var(--ink); font-size: 0.98rem; }
  .gauge-track {
    position: relative; height: 16px; border-radius: 999px;
    /* Monochromatic buy→sell ramp: gold (low price) → white (high price), owner
       directive 2026-06-13 — clean midtone, no muddy grey. The white sell end gets a
       crisp edge against the parchment via the border + an inset hairline. */
    background: linear-gradient(90deg, var(--gauge-buy) 0%, var(--gauge-sell) 100%);
    border: 1px solid var(--panel-edge);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.06);
  }
  .gauge-iqr {
    position: absolute; left: 25%; right: 25%; top: 0; bottom: 0;
    background: rgba(0,0,0,0.18); border-left: 2px dashed rgba(0,0,0,0.35); border-right: 2px dashed rgba(0,0,0,0.35);
  }
  .gauge-marker { position: absolute; top: -6px; width: 0; height: 28px; }
  .gauge-marker::before {
    content: ""; position: absolute; left: -7px; top: 0;
    border-left: 7px solid transparent; border-right: 7px solid transparent; border-top: 9px solid var(--ink);
  }
  .gauge-marker::after { content:""; position:absolute; left:-1px; top: 6px; width:2px; height:22px; background: var(--ink); }
  .gauge-marker-label { position: absolute; top: 30px; left: 50%; transform: translateX(-50%); white-space: nowrap; font-size: 0.7rem; color: var(--ink); }
  .gauge-marker-label.at-start { left: 0; transform: none; }
  .gauge-marker-label.at-end { left: auto; right: 0; transform: none; }
  .gauge-scale { display:flex; justify-content: space-between; gap: var(--s-3); margin-top: var(--s-5); }
</style>
